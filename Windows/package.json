{
  "name": "rev-techingmaster-windows",
  "version": "1.0.0",
  "description": "Agent备课 电脑版（Electron）：初中教学备课智能助手",
  "main": "main.js",
  "author": "Agent备课",
  "license": "AGPL-3.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "portable": "electron-builder --win portable",
    "build:icon": "node build-icon.js --master build/icon-master-600.png",
    "sign": "node sign.js",
    "sign:trust": "node sign.js --trust",
    "sign:verify": "node sign.js --verify"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.rev.techingmaster",
    "productName": "Agent备课",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent备课",
      "artifactName": "AgentBeike-Setup-${version}.${ext}"
    }
  }
}
