  /** 读取当前语言：'zh' | 'en' | 'ug' | 'bo' | 'mn'（默认 zh） */
  static currentLang(): string {
    const v = AppStorage.get<string>(I18n.LANG_KEY);
    if (v === 'en' || v === 'ug' || v === 'bo' || v === 'mn') {
      return v;
    }
    return 'zh';
  }

  /** 按语言代码取对应词典 */
  private static pick(lang: string): Map<string, string> {
    if (lang === 'en') {
      return I18n.en;
    }
    if (lang === 'ug') {
      return UyghurDict.dict;
    }
    if (lang === 'bo') {
      return TibetanDict.dict;
    }
    if (lang === 'mn') {
      return MongolianDict.dict;
    }
    return I18n.zh;
  }

  /** 当前语言对应的 BCP-47 标记（用于导出 Word/PPTX 时标注文本语言，保证换行与字体正确） */
  static bcp47(): string {
    const lang: string = I18n.currentLang();
    if (lang === 'en') {
      return 'en-US';
    }
    if (lang === 'ug') {
      return 'ug-CN';
    }
    if (lang === 'bo') {
      return 'bo-CN';
    }
    if (lang === 'mn') {
      return 'mn-CN';
    }
    return 'zh-CN';
  }

  /** 功能区角标：中文沿用精选单字，其它语言取该功能标题首字符（保证五种语言下都可读） */
  static badge(zhGlyph: string, titleKey: string): string {
    if (I18n.currentLang() === 'zh') {
      return zhGlyph;
    }
    const title: string = I18n.t(titleKey);
    return title.length > 0 ? title.charAt(0) : zhGlyph;
  }

  /** 服务端错误文案本地化：服务端固定返回中文，此处按当前界面语言映射；未知文案原样返回 */
  static serverMsg(raw: string): string {
    if (raw === '任务已取消') {
      return I18n.t('err.canceled');
    }
    if (raw === '请求过于频繁，请稍后再试') {
      return I18n.t('err.rateLimit');
    }
    if (raw === '任务不存在') {
      return I18n.t('err.taskMissing');
    }
    if (raw === '服务异常，请稍后再试') {
      return I18n.t('err.serverBusy');
    }
    return raw;
  }

  /** 语言清单：顺序即设置页语言选择框的展示顺序 */
  static readonly LANG_CODES: string[] = ['zh', 'en', 'ug', 'bo', 'mn'];

  /** 语言自身的名称：固定用该语言本身书写，不随界面语言变化（如 简体中文 / English / ئۇيغۇرچە） */
  static langSelf(code: string): string {
    if (code === 'en') {
      return 'English';
    }
    if (code === 'ug') {
      return 'ئۇيغۇرچە';
    }
    if (code === 'bo') {
      return 'བོད་སྐད།';
    }
    if (code === 'mn') {
      return 'Монгол хэл';
    }
    return '简体中文';
  }

  /** 按 key 取当前语言文本；少数民族语言缺词时回退中文 */
  static t(key: string): string {
    const lang: string = I18n.currentLang();
    const dict: Map<string, string> = I18n.pick(lang);
    let text: string | undefined = dict.get(key);
    if (text === undefined && dict !== I18n.zh) {
      text = I18n.zh.get(key);
    }
    return text !== undefined ? text : key;
  }
}
