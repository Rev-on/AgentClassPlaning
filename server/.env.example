# 服务端配置示例：复制为 .env 后填写真实值
# DeepSeek 开放平台的 API Key（请勿提交到仓库）
DEEPSEEK_API_KEY=sk-在这里填写你的密钥

# 监听端口与地址
PORT=3000
HOST=0.0.0.0

# 上游模型（可选，缺省时透传客户端请求里的模型）
# MODEL=deepseek-v4-flash

# 代理访问令牌（强烈建议设置；App 端 ApiConfig.PROXY_TOKEN 需保持一致）
# PROXY_TOKEN=请设置一段随机字符串

# 上游超时（毫秒）与简易限流（次/分钟）
REQUEST_TIMEOUT_MS=150000
RATE_LIMIT_PER_MIN=120

# ===== 账号体系 =====
# AUTH_REQUIRED=true 时，AI 接口要求携带登录令牌
AUTH_REQUIRED=false

# ===== 认证服务 / 华为登录（网页授权码 + 服务端换 token）=====
# 认证服务页面显示的客户端 ID 为 6917615335790825716（App ID），Client Secret 填到 HUAWEI_APP_SECRET
HUAWEI_CLIENT_ID=6917615335790825716
HUAWEI_APP_SECRET=
