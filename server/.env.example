# 服务端配置示例：复制为 .env 后填写真实值
# DeepSeek 开放平台的 API Key（请勿提交到仓库）
DEEPSEEK_API_KEY=sk-在这里填写你的密钥

# 监听端口与地址
PORT=3000
HOST=0.0.0.0

# 上游模型（可选，缺省时透传客户端请求里的模型）
# MODEL=deepseek-v4-flash

# 代理访问令牌（强烈建议设置；App 端 ApiConfig.PROXY_TOKEN 需保持一致）
# PROXY_TOKEN=请设置一段随机字符串

# 上游超时（毫秒）与简易限流（次/分钟）
REQUEST_TIMEOUT_MS=150000
RATE_LIMIT_PER_MIN=120

# ---------- 华为 Push Kit 服务端推送（可选，未配置时完成通知自动跳过） ----------
# AppGallery Connect「项目设置」中的项目 ID
# AGC_PROJECT_ID=
# 服务账号密钥：方式一：把 AGC 下载的服务账号 JSON 放到服务器并指向它
# AGC_PUSH_ACCOUNT_FILE=/root/rev-ai-proxy/agc-push-account.json
# 方式二：直接填三项（私钥里的换行写成 \n）
# AGC_JWT_KID=
# AGC_JWT_ISS=
# AGC_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 测试消息开关（true=调测消息，每日全网 1000 条上限）
# AGC_PUSH_TEST=true
# 通知自分类（默认 MARKETING 资讯营销类；正式量大请申请“服务与通讯”权益后改为对应值）
# AGC_PUSH_CATEGORY=MARKETING
