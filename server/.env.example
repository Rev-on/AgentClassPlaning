# 服务端配置示例：复制为 .env 后填写真实值
# DeepSeek 开放平台的 API Key（请勿提交到仓库）
DEEPSEEK_API_KEY=sk-在这里填写你的密钥

# 监听端口与地址
# HOST=:: 表示同时监听 **IPv6 与 IPv4**（双栈）。
#   原因：Linux 默认 net.ipv6.bindv6only=0，绑定 :: 会同时接受 IPv4 连接
#   （表现为 IPv4 地址映射成 ::ffff:1.2.3.4），一份配置覆盖两种客户端，
#   客户端无论走 IPv4 还是 IPv6 都能连上。
#   若填 0.0.0.0 则**只监听 IPv4**，纯 IPv6 客户端会连不上。
PORT=3000
HOST=::

# 上游模型（可选，缺省时透传客户端请求里的模型）
# MODEL=deepseek-v4-flash

# 代理访问令牌（强烈建议设置；App 端 ApiConfig.PROXY_TOKEN 需保持一致）
# PROXY_TOKEN=请设置一段随机字符串

# 上游超时（毫秒）与简易限流（次/分钟）
REQUEST_TIMEOUT_MS=600000
RATE_LIMIT_PER_MIN=120

# 深度思考强度（仅在客户端开启"深度思考"开关时生效）：high | max
# THINKING_EFFORT=high

# ---------- 华为 Push Kit 服务端推送（7 大 AI 生成功能的"完成通知"） ----------
# 用途：用户在 App 内发起教案/课件/分层练习/教研/学情分析/沟通话术/学情报告生成后，
#       生成任务在服务端后台继续执行；完成时由服务端经华为 Push Kit 下发系统通知，
#       因此**退到后台或进程被杀也能收到**"已生成完成"提醒。
#
# 【必需】推送总开关：不设为 1 则完成通知一律静默跳过（只写日志，不影响生成）。
#   之所以默认关闭：未配置 AGC 凭据的部署若默认开启，每个任务都会打一条推送失败日志。
# PUSH_ENABLED=1
#
# 【必需】以下 4 项 AGC 凭据二选一填写：
# AppGallery Connect「项目设置」中的项目 ID
# AGC_PROJECT_ID=
# 方式一（推荐）：把 AGC 下载的服务账号 JSON 放到服务器并指向它
# AGC_PUSH_ACCOUNT_FILE=/root/rev-ai-proxy/agc-push-account.json
# 方式二：直接填三项（私钥里的换行写成 \n）
# AGC_JWT_KID=
# AGC_JWT_ISS=
# AGC_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# 凭据自检：node tools/check_push.js（会真的向华为换取 access_token，是凭据有效的硬证据）
#
# 测试消息开关（true=调测消息，每日全网 1000 条上限）
# AGC_PUSH_TEST=true
# 通知自分类（默认 WORK 工作事项提醒，属"服务提醒"类，送达更可靠）
# 合法取值（经华为接口实测确认）：
#   MARKETING, IM, VOIP, SUBSCRIPTION, TRAVEL, HEALTH, WORK,
#   ACCOUNT, EXPRESS, FINANCE, DEVICE_REMINDER, MAIL, NEWS
# 注意 MARKETING 属"资讯营销"，用户可整体关闭营销通知而收不到，
# 本应用的通知是用户主动发起的任务完成提醒，应使用 WORK。
# AGC_PUSH_CATEGORY=WORK
# 通知渠道类型 slotType —— 决定「响铃 + 横幅」。
#
#   ⚠️ 只设这里是不够的！真正决定"是否响铃、是否弹横幅"的是
#      **客户端已注册的通知渠道**（entry/src/main/ets/common/NotifySlot.ets）。
#      若客户端未注册对应渠道，通知会落到默认低级别渠道 →
#      "能收到通知，但不响铃、无横幅"。
#
#   取值与客户端 SlotType 一一对应（以 OpenHarmony 官方 d.ts 为准）：
#     0 = UNKNOWN_TYPE         未知（静默）
#     1 = SOCIAL_COMMUNICATION 社交通信 → 横幅 + 提示音   ← 默认（本应用要响铃+横幅）
#     2 = SERVICE_INFORMATION  服务提醒 → 提示音（无横幅）
#     3 = CONTENT_INFORMATION  内容资讯 → 静默
#   默认 1，与客户端注册的 SOCIAL_COMMUNICATION 渠道配对。
# AGC_PUSH_SLOT_TYPE=1
#
# 【前台是否弹通知】默认 false。
#   华为的设计：App 在前台时不弹推送通知，避免与页面内展示重复
#   （本应用前台已有实况窗 + 结果面板显示进度）。
#   ⚠️ 副作用：**在 App 前台测试时永远收不到通知**，极易被误判为"推送坏了"。
#   联调期可临时打开以下开关，在前台也能看到通知：
# AGC_PUSH_FOREGROUND_SHOW=true
#
# 客户端侧同样需要"通知权限"：首次启动时 App 会主动申请（EntryAbility），
# 若用户曾拒绝，需在 系统设置 → 通知 中为"备课助手"手动开启，否则通知被系统丢弃。

# ---------- 华为 Push Kit 消息回执（可选，用于确认推送是否真正送达） ----------
# 在 AGC「项目设置 → 消息回执」开通「消息回执」权益后，按下表填写。
# 「回调地址」填本服务的回执路由（见下方注释）。
# 回执用户名/密钥与 AGC 上填写的保持一致；两者都配置后，华为会在请求头带
# X-HUAWEI-CALLBACK-ID，本服务据此用密钥做 HMAC-SHA256 校验。
# 对应 AGC 配置项：回调名称 / 回调地址 / 回调用户名 / 回调密钥
PUSH_CALLBACK_USER=revtech
PUSH_CALLBACK_SECRET=请替换为随机字符串
# 回执接收路径（需与 AGC 回调地址末段一致）
PUSH_CALLBACK_PATH=/api/push/receipt

# ---------- 数据留存期与自动过期清理（合规：隐私协议据此如实声明留存期限） ----------
# 服务端会周期性（默认每 10 分钟）清理过期数据并重新落盘，日志形如：
#   [tasks] 过期清理：删除任务 N 条（留存 24h）、删除设备 M 条（留存 90d）
#
# 任务留存期（小时）：tasks.json 中的任务包含设备标识、学科/年级、用户提示词、
#   生成结果与深度思考(reasoning)。**已结束(done/failed)** 的任务超过该时长后，
#   会从内存与 data/tasks.json 中一并删除；**排队中(pending)/运行中(running)
#   的任务永不清理**，避免误删正在生成的结果。默认 24 小时，与 App 端
#   "结果已由客户端入库、服务端只保留最近 24h" 的既有语义一致。
# TASK_RETENTION_HOURS=24
#
# 设备留存期（天）：data/devices.json 中的设备 Push Token 记录，
#   updatedAt 超过该时长（即长期不活跃）后删除，避免 token 永久留存。默认 90 天。
# DEVICE_RETENTION_DAYS=90
#
# 周期清理间隔（毫秒），一般无需修改；默认 600000 = 10 分钟。
# 定时器已 unref()，不会阻止进程退出。
# PURGE_INTERVAL_MS=600000
#
# 说明：以上变量留空、填 0、负数或非法值时一律回退默认值（避免误配成 0 而把刚生成的数据立刻删掉）。
# 自测：node tools/test_retention.js（使用临时 DATA_DIR，不会污染 data/）
#
# ---------- 用户主动删除服务器数据（配合隐私协议的"可随时删除"承诺） ----------
# 接口：POST /api/data/delete   body: {"deviceId":"<设备标识>"}
# 鉴权：与其它受保护路由一致走 PROXY_TOKEN（请求头 x-proxy-token），
#       防止任意人凭一个 deviceId 就删掉他人数据。
# 语义：删除该 deviceId 名下的**全部任务记录**（含 user/system 提示词、content 生成结果、
#       reasoning 思维链，不论 pending/running/done/failed）与 devices.json 中的设备注册记录；
#       正在生成的任务会先被中断再删除。
# 返回：{ok:true, tasks:n, devices:m}（n/m 为实际删除条数；重复调用返回 0，幂等）
# 安全：只删 deviceId **完全相等**的记录；deviceId 为空一律返回 400，绝不退化为"删除全部"。
# 注意：客户端本地已入库的结果不受影响；删除后不可恢复。
