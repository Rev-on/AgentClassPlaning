# 服务端配置示例：复制为 .env 后填写真实值
# DeepSeek 开放平台的 API Key（请勿提交到仓库）
DEEPSEEK_API_KEY=sk-在这里填写你的密钥

# 监听端口与地址
PORT=3000
HOST=0.0.0.0

# 上游模型（可选，缺省时透传客户端请求里的模型）
# MODEL=deepseek-v4-flash

# 代理访问令牌（强烈建议设置；App 端 ApiConfig.PROXY_TOKEN 需保持一致）
# PROXY_TOKEN=请设置一段随机字符串

# 上游超时（毫秒）与简易限流（次/分钟）
REQUEST_TIMEOUT_MS=150000
RATE_LIMIT_PER_MIN=120
